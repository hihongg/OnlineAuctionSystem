<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.SellerItemsController"
      style="-fx-padding: 30; -fx-background-color: #000000;"
      stylesheets="@dark-theme.css">

    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: #111111; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #222222; -fx-border-radius: 10; -fx-border-width: 1;">
        <Label fx:id="lblTitle" text="SẢN PHẨM CỦA TÔI" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✏ Sửa sản phẩm" onAction="#handleEdit" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-background-radius: 20; -fx-cursor: hand;"/>
        <Button text="🗑 Xóa sản phẩm" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-background-radius: 20; -fx-cursor: hand;"/>
        <Button fx:id="btnRefresh" text="🔄 Làm mới" onAction="#handleRefresh" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-background-radius: 20; -fx-cursor: hand;"/>
        <Button text="◀ Quay lại" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13;"/>
    </HBox>

    <Label text="Chọn một sản phẩm rồi nhấn Sửa hoặc Xóa. Chỉ có thể sửa/xóa sản phẩm chưa ở trạng thái RUNNING." style="-fx-text-fill: #95a5a6; -fx-font-size: 13;"/>

    <TableView fx:id="tableItems" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"       text="ID"        prefWidth="50"  minWidth="40"/>
            <TableColumn fx:id="colName"     text="Tên sản phẩm" prefWidth="260" minWidth="120"/>
            <TableColumn fx:id="colCategory" text="Loại"      prefWidth="110" minWidth="80"/>
            <TableColumn fx:id="colPrice"    text="Giá hiện tại ($)" prefWidth="140" minWidth="100"/>
            <TableColumn fx:id="colStatus"   text="Trạng thái" prefWidth="120" minWidth="80"/>
            <TableColumn fx:id="colEndTime"  text="Thời gian kết thúc" prefWidth="200" minWidth="150"/>
        </columns>
        <placeholder>
            <Label text="Bạn chưa có sản phẩm nào. Nhấn '➕ Đăng bán sản phẩm' để thêm mới." style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;"/>
        </placeholder>
    </TableView>
</VBox>