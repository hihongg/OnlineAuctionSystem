<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controllers.CreateItemController">

    <VBox alignment="TOP_CENTER" maxWidth="500.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <Label text="Đăng Bán Sản Phẩm" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="Vui lòng điền thông tin món đồ bạn muốn đấu giá" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>

        <Region prefHeight="15.0" />

        <VBox spacing="5.0">
            <Label text="Tên sản phẩm:" style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 14px;"/>
            <TextField fx:id="txtName" promptText="Ví dụ: Tai nghe Sony WH-1000XM5" style="-fx-font-size: 14px; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Giá khởi điểm ($):" style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 14px;"/>
            <TextField fx:id="txtPrice" promptText="Ví dụ: 250.0" style="-fx-font-size: 14px; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Hạn chót đấu giá (Ngày &amp; Giờ):" style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 14px;"/>
            <HBox spacing="10.0">
                <DatePicker fx:id="datePickerEnd" promptText="Chọn ngày" style="-fx-font-size: 14px; -fx-padding: 4;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <TextField fx:id="txtTimeEnd" promptText="HH:mm (VD: 23:59)" prefWidth="150.0" style="-fx-font-size: 14px; -fx-padding: 10;"/>
            </HBox>
        </VBox>

        <Region prefHeight="25.0" />

        <HBox alignment="CENTER" spacing="20.0">
            <Button text="Quay lại" onAction="#handleCancel" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-cursor: hand;"/>
            <Button text="Xác nhận Đăng bán" onAction="#handleCreate" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</VBox>