<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="900.0" spacing="0"
      style="-fx-background-color: #000000;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.CreateItemController">

    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: #000000; -fx-background-insets: 0;">

        <StackPane alignment="TOP_CENTER" style="-fx-padding: 40 20 40 20;">

            <VBox alignment="TOP_CENTER" maxWidth="540.0" spacing="15.0"
                  style="-fx-background-color: #111111; -fx-padding: 40; -fx-background-radius: 12; -fx-border-color: #333333; -fx-border-radius: 12; -fx-border-width: 1;">

                <Label text="ĐĂNG BÁN SẢN PHẨM"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>
                <Label text="Vui lòng điền thông tin món đồ bạn muốn đấu giá"
                       style="-fx-text-fill: #aaaaaa; -fx-font-size: 14;"/>

                <Region prefHeight="10.0"/>

                <VBox spacing="5.0">
                    <Label text="Tên sản phẩm:" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <TextField fx:id="txtName" promptText="Ví dụ: Tai nghe Sony WH-1000XM5"
                               style="-fx-font-size: 14; -fx-padding: 10; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #555555; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Mô tả sản phẩm:" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <TextArea fx:id="txtDescription" promptText="Mô tả chi tiết: tình trạng, thông số kỹ thuật, phụ kiện đi kèm..." prefRowCount="4" wrapText="true"
                              style="-fx-font-size: 14; -fx-control-inner-background: #000000; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #555555; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Loại sản phẩm:" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <ComboBox fx:id="cmbCategory" maxWidth="Infinity"
                              style="-fx-font-size: 14; -fx-background-color: #000000; -fx-border-color: #555555; -fx-border-radius: 6; -fx-text-fill: white;"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label text="Hình ảnh sản phẩm:" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <StackPane fx:id="imagePreviewPane" prefHeight="180.0"
                               style="-fx-background-color: #000000; -fx-border-color: #555555; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <Label fx:id="lblImagePlaceholder" text="Chưa chọn ảnh&#10;(Click 'Chọn ảnh' để tải lên)" textAlignment="CENTER" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13;"/>
                        <ImageView fx:id="imgPreview" fitHeight="176.0" fitWidth="430.0" preserveRatio="true" visible="false"/>
                    </StackPane>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Button text="📁 Chọn ảnh..." onAction="#handleChooseImage" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 7 18 7 18; -fx-cursor: hand; -fx-background-radius: 5;"/>
                        <Button fx:id="btnClearImage" text="✕ Xóa ảnh" onAction="#handleClearImage" visible="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 7 18 7 18; -fx-cursor: hand; -fx-background-radius: 5;"/>
                        <Label fx:id="lblImageName" text="" style="-fx-text-fill: #27ae60; -fx-font-size: 12;" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Giá khởi điểm ($):" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <TextField fx:id="txtPrice" promptText="Ví dụ: 250.0" style="-fx-font-size: 14; -fx-padding: 10; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #555555; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Thời gian bắt đầu:" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <Label text="(Để trống = bắt đầu ngay khi đăng)" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12;"/>
                    <HBox spacing="10.0">
                        <DatePicker fx:id="datePickerStart" promptText="Chọn ngày" style="-fx-font-size: 14; -fx-background-color: #000000;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <TextField fx:id="txtTimeStart" promptText="HH:mm  (VD: 09:00)" prefWidth="160.0" style="-fx-font-size: 14; -fx-padding: 10; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #555555; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                    </HBox>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Hạn chót đấu giá *" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <HBox spacing="10.0">
                        <DatePicker fx:id="datePickerEnd" promptText="Chọn ngày" style="-fx-font-size: 14; -fx-background-color: #000000;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <TextField fx:id="txtTimeEnd" promptText="HH:mm  (VD: 23:59)" prefWidth="160.0" style="-fx-font-size: 14; -fx-padding: 10; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #555555; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                    </HBox>
                </VBox>

                <Region prefHeight="10.0"/>

                <HBox alignment="CENTER" spacing="20.0">
                    <Button text="Quay lại" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-border-color: #aaaaaa; -fx-border-radius: 6; -fx-text-fill: #aaaaaa; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 10 25 10 25; -fx-cursor: hand; -fx-background-radius: 6;"/>
                    <Button text="Xác nhận Đăng bán" fx:id="btnConfirm" onAction="#handleCreate" style="-fx-background-color: #3665F3; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 10 25 10 25; -fx-cursor: hand; -fx-background-radius: 6;"/>
                </HBox>

            </VBox>
        </StackPane>
    </ScrollPane>
</VBox>