<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefHeight="680.0" prefWidth="900.0" spacing="0"
      style="-fx-background-color: #000000;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.EditItemController">

    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: #000000; -fx-background-insets: 0;">

        <StackPane alignment="TOP_CENTER" style="-fx-padding: 40 20 40 20;">

            <VBox alignment="TOP_CENTER" maxWidth="540.0" spacing="15.0"
                  style="-fx-background-color: #111111; -fx-padding: 40; -fx-background-radius: 12; -fx-border-color: #333333; -fx-border-radius: 12; -fx-border-width: 1;">

                <Label text="✏ SỬA THÔNG TIN"
                       style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>
                <Label fx:id="lblItemId" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13;"/>
                <Label text="Chỉ có thể sửa khi sản phẩm ở trạng thái Sắp diễn ra (OPEN)"
                       style="-fx-text-fill: #e67e22; -fx-font-size: 12;"/>

                <Region prefHeight="5.0"/>

                <VBox spacing="5.0">
                    <Label text="Tên sản phẩm *" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <TextField fx:id="txtName" promptText="Nhập tên sản phẩm" style="-fx-padding: 10; -fx-border-color: #555555; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Mô tả sản phẩm" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <TextArea fx:id="txtDescription" promptText="Mô tả chi tiết về sản phẩm..." prefRowCount="4" wrapText="true"
                              style="-fx-font-size: 14; -fx-control-inner-background: #000000; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #555555; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Giá khởi điểm ($) *" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <TextField fx:id="txtPrice" promptText="Ví dụ: 100.00" style="-fx-padding: 10; -fx-border-color: #555555; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Ngày kết thúc *" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <DatePicker fx:id="datePickerEnd" prefWidth="200" style="-fx-font-size: 14; -fx-background-color: #000000; -fx-border-color: #555555; -fx-border-radius: 6;"/>
                        <TextField fx:id="txtTimeEnd" promptText="HH:mm  (vd: 18:00)" prefWidth="130" style="-fx-padding: 10; -fx-border-color: #555555; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14;"/>
                    </HBox>
                </VBox>

                <Label fx:id="lblError" wrapText="true" maxWidth="440" visible="false" managed="false"
                       style="-fx-text-fill: #e74c3c; -fx-font-size: 13; -fx-background-color: #2c0b0e; -fx-padding: 8 12 8 12; -fx-background-radius: 6; -fx-border-color: #e74c3c; -fx-border-radius: 6;"/>

                <Region prefHeight="5.0"/>

                <HBox spacing="15" alignment="CENTER">
                    <Button text="✖ Hủy" onAction="#handleCancel" prefWidth="120" prefHeight="44" style="-fx-background-color: transparent; -fx-border-color: #aaaaaa; -fx-border-radius: 6; -fx-text-fill: #aaaaaa; -fx-font-size: 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    <Button fx:id="btnSave" text="💾 Lưu thay đổi" onAction="#handleSave" prefWidth="180" prefHeight="44" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>

            </VBox>
        </StackPane>
    </ScrollPane>
</VBox>