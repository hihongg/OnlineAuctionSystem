<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefHeight="680.0" prefWidth="900.0" spacing="20.0"
      style="-fx-background-color: #f4f4f4; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.EditItemController">

    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background-insets: 0;">
        <VBox alignment="TOP_CENTER" maxWidth="520.0" spacing="15.0"
              style="-fx-background-color: white;
                     -fx-padding: 40;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

            <!-- ── Tiêu đề ── -->
            <Label text="✏ Sửa Thông Tin Sản Phẩm"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblItemId"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
            <Label text="Chỉ có thể sửa khi sản phẩm ở trạng thái Sắp diễn ra (OPEN)"
                   style="-fx-text-fill: #e67e22; -fx-font-size: 12;"/>

            <Region prefHeight="5.0"/>

            <!-- ── Tên sản phẩm ── -->
            <VBox spacing="5.0">
                <Label text="Tên sản phẩm *"
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="txtName"
                           promptText="Nhập tên sản phẩm"
                           style="-fx-padding: 10; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-font-size: 14;"/>
            </VBox>

            <!-- ── Mô tả ── -->
            <VBox spacing="5.0">
                <Label text="Mô tả sản phẩm"
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextArea fx:id="txtDescription"
                          promptText="Mô tả chi tiết về sản phẩm..."
                          prefRowCount="4"
                          wrapText="true"
                          style="-fx-padding: 10; -fx-border-color: #ddd;
                                 -fx-border-radius: 6; -fx-background-radius: 6;
                                 -fx-font-size: 14;"/>
            </VBox>

            <!-- ── Giá khởi điểm ── -->
            <VBox spacing="5.0">
                <Label text="Giá khởi điểm ($) *"
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="txtPrice"
                           promptText="Ví dụ: 100.00"
                           style="-fx-padding: 10; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-font-size: 14;"/>
                <Label text="⚠ Giá khởi điểm chỉ được sửa khi chưa có người đặt giá"
                       style="-fx-text-fill: #e67e22; -fx-font-size: 11;"/>
            </VBox>

            <!-- ── Thời gian kết thúc ── -->
            <VBox spacing="5.0">
                <Label text="Ngày kết thúc *"
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <DatePicker fx:id="datePickerEnd" prefWidth="200"
                                style="-fx-font-size: 14;"/>
                    <TextField fx:id="txtTimeEnd"
                               promptText="HH:mm  (vd: 18:00)"
                               prefWidth="130"
                               style="-fx-padding: 10; -fx-border-color: #ddd;
                                      -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-font-size: 14;"/>
                </HBox>
                <Label text="Thời gian kết thúc phải cách hiện tại ít nhất 5 phút"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
            </VBox>

            <!-- ── Thông báo lỗi ── -->
            <Label fx:id="lblError" wrapText="true" maxWidth="440"
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 13;
                          -fx-background-color: #fde8e8; -fx-padding: 8 12 8 12;
                          -fx-background-radius: 6;"/>

            <Region prefHeight="5.0"/>

            <!-- ── Nút hành động ── -->
            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="btnSave" text="💾 Lưu thay đổi" onAction="#handleSave"
                        prefWidth="180" prefHeight="44"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-size: 15; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="✖ Hủy" onAction="#handleCancel"
                        prefWidth="120" prefHeight="44"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-size: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>
