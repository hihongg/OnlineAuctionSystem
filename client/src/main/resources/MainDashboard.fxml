<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.MainDashboardController"
      style="-fx-padding: 30; -fx-background-color: #f4f4f4;">

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Online Auction System" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colItemName" text="Item Name" prefWidth="400" />
            <TableColumn fx:id="colCurrentBid" text="Current Bid ($)" prefWidth="200" />
            <TableColumn fx:id="colTimeLeft" text="Time Left" prefWidth="240" />
            <TableColumn fx:id="colAction" text="Action" prefWidth="120" />
        </columns>
    </TableView>

</VBox>