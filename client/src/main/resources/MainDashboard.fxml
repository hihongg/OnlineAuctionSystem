<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.MainDashboardController"
      style="-fx-padding: 30; -fx-background-color: #f4f4f4;">

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Online Auction System" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="➕ Đăng bán" onAction="#showCreateAuctionForm" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
    </HBox>

    <FlowPane fx:id="itemGrid" VBox.vgrow="ALWAYS" hgap="20" vgap="20" alignment="TOP_LEFT" style="-fx-padding: 20;" />

</VBox>