<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.MainDashboardController"
      style="-fx-padding: 30; -fx-background-color: #F4F6F9;">

    <!-- ── Header ──────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
        <Label text="eBay Auction"
               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0064D2;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Nút Admin Panel — chỉ hiển thị khi currentRole = ADMIN (ẩn/hiện trong Controller) -->
        <Button fx:id="btnAdminPanel" text="⚙ Admin Panel"
                onAction="#handleAdminPanel"
                visible="false" managed="false"
                style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-padding: 8 16 8 16; -fx-background-radius: 20; -fx-cursor: hand;"/>

        <!-- Nút Ví tiền — chỉ hiển thị khi currentRole = BIDDER -->
        <Button fx:id="btnWallet" text="💰 Ví của tôi"
                onAction="#handleWallet"
                visible="false" managed="false"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-padding: 8 16 8 16; -fx-background-radius: 20; -fx-cursor: hand;"/>

        <!-- Nút Giỏ hàng — chỉ hiển thị khi currentRole = BIDDER -->
        <Button fx:id="btnWonItems" text="🛒 Giỏ hàng"
                onAction="#handleWonItems"
                visible="false" managed="false"
                style="-fx-background-color: #e67e22; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-padding: 8 16 8 16; -fx-background-radius: 20; -fx-cursor: hand;"/>

        <Button text="➕ Đăng bán sản phẩm" onAction="#handleCreateItem"
                style="-fx-background-color: #3665F3; -fx-text-fill: white;
                       -fx-font-size: 14; -fx-font-weight: bold;
                       -fx-padding: 8 20 8 20; -fx-background-radius: 20; -fx-cursor: hand;"/>
        <Button text="Đăng xuất" onAction="#handleLogout"
                style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;
                       -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <!-- ── Search bar ──────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="txtSearch" promptText="🔍 Tìm kiếm tên sản phẩm đấu giá..."
                   prefWidth="450"
                   style="-fx-padding: 12 20 12 20; -fx-font-size: 14;
                          -fx-background-radius: 25; -fx-border-radius: 25;
                          -fx-border-color: #3665F3; -fx-border-width: 1.5;
                          -fx-background-color: white;"/>
        <Button text="🔄 Làm mới" onAction="#handleRefresh"
                style="-fx-background-color: white; -fx-text-fill: #3665F3;
                       -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-padding: 10 22 10 22; -fx-background-radius: 25;
                       -fx-border-radius: 25; -fx-border-color: #3665F3;
                       -fx-border-width: 1.5; -fx-cursor: hand;"/>
    </HBox>

    <!-- ── Item grid ───────────────────────────────────────────────── -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background-insets: 0;">
        <FlowPane fx:id="itemGrid" hgap="20" vgap="20" alignment="TOP_LEFT"
                  style="-fx-background-color: transparent;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </FlowPane>
    </ScrollPane>

</VBox>
