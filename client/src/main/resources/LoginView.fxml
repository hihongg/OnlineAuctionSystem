<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox prefHeight="500.0" prefWidth="800.0"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.LoginController">


    <VBox prefWidth="400.0" alignment="CENTER" spacing="15.0" style="-fx-padding: 40px;">
        <Label text="Create Account" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <TextField fx:id="txtEmail" promptText="Email Address" />
        <PasswordField fx:id="txtPassword" promptText="Password" />

        <CheckBox text="I agree to the terms..." />

        <Button text="Sign Up" onAction="#handleSignUp" prefWidth="320.0" style="-fx-background-color: #4C4DD1; -fx-text-fill: white; -fx-background-radius: 20px;"/>
    </VBox>

</HBox>