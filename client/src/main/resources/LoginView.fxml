<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox prefHeight="500.0" prefWidth="800.0"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.LoginController"
      style="-fx-background-image: url('file:client/src/main/resources/images/LoginView.jpg'); -fx-background-size: cover; -fx-background-position: center center;">

    <VBox prefWidth="400.0" alignment="CENTER" spacing="15.0"
          style="-fx-background-color: transparent; -fx-padding: 40px;">

        <!-- Tiêu đề động (thay đổi theo mode) -->
        <Label fx:id="lblTitle" text="Login" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <!-- Form Login -->
        <VBox fx:id="loginForm" spacing="15.0">
            <TextField fx:id="txtLoginUsername" promptText="Username"
                       style="-fx-pref-height: 40px; -fx-background-radius: 5px;"/>
            <PasswordField fx:id="txtLoginPassword" promptText="Password"
                           style="-fx-pref-height: 40px; -fx-background-radius: 5px;"/>
            <Button text="Login" onAction="#handleLogin" prefWidth="320.0"
                    style="-fx-background-color: #4C4DD1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px; -fx-background-radius: 5px; -fx-cursor: hand;"/>
            <Hyperlink fx:id="lnkSwitch" text="Don't have an account? Sign Up"
                       onAction="#handleSwitchMode"
                       style="-fx-text-fill: white; -fx-font-size: 13px;"/>
        </VBox>

        <!-- Form Register (ẩn mặc định) -->
        <VBox fx:id="registerForm" spacing="15.0" visible="false" managed="false">
            <TextField fx:id="txtEmail" promptText="Username"
                       style="-fx-pref-height: 40px; -fx-background-radius: 5px;"/>
            <PasswordField fx:id="txtPassword" promptText="Password"
                           style="-fx-pref-height: 40px; -fx-background-radius: 5px;"/>
            <CheckBox text="I agree to the terms..." style="-fx-text-fill: white;"/>
            <Button text="Sign Up" onAction="#handleSignUp" prefWidth="320.0"
                    style="-fx-background-color: #4C4DD1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px; -fx-background-radius: 5px; -fx-cursor: hand;"/>
            <Hyperlink text="Already have an account? Login"
                       onAction="#handleSwitchMode"
                       style="-fx-text-fill: white; -fx-font-size: 13px;"/>
        </VBox>

    </VBox>

</HBox>
