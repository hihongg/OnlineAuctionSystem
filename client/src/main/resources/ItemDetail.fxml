<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<!--
    ItemDetail.fxml — Màn hình chi tiết sản phẩm đấu giá
    Bổ sung so với bản cũ:
      - lblBidder  : tên người đang dẫn đầu
      - lblStatus  : trạng thái phiên (RUNNING / FINISHED / CANCELED)
      - bidChart   : LineChart lịch sử giá realtime
      - imgProduct : ảnh sản phẩm
      - txtDescription : mô tả sản phẩm
-->
<VBox alignment="TOP_CENTER" spacing="15"
      style="-fx-padding: 20; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.ItemDetailController">

    <!-- ── Thanh điều hướng ─────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="⬅ Quay lại" onAction="#handleBackToDashboard"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Chi tiết sản phẩm"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    </HBox>

    <!-- ── Nội dung chính (ScrollPane để cuộn nếu nội dung dài) ─ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background-insets: 0;">
        <VBox spacing="15" style="-fx-padding: 5;">

            <!-- ── Card thông tin sản phẩm ─────────────────────── -->
            <HBox spacing="20" style="-fx-background-color: white; -fx-padding: 20;
                  -fx-background-radius: 10;
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 3);">

                <!-- Ảnh sản phẩm -->
                <StackPane prefWidth="200" prefHeight="180"
                           style="-fx-background-color: #F9FAFB; -fx-background-radius: 8;">
                    <ImageView fx:id="imgProduct"
                               fitWidth="190" fitHeight="170"
                               pickOnBounds="true" preserveRatio="true"/>
                </StackPane>

                <!-- Thông tin bên phải ảnh -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblName" text="Tên sản phẩm"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                           wrapText="true"/>

                    <Label fx:id="lblStatus" text="🟢 Đang diễn ra"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>

                    <Separator/>

                    <Label fx:id="lblPrice" text="Giá hiện tại: $0.00"
                           style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #e1b12c;"/>

                    <Label fx:id="lblBidder" text="Người dẫn đầu: Chưa có"
                           style="-fx-font-size: 14; -fx-text-fill: #636e72;"/>

                    <Label fx:id="lblTime" text="⏱ Đang tải..."
                           style="-fx-font-size: 15; -fx-text-fill: #e84118; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- ── Mô tả sản phẩm ──────────────────────────────── -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15;
                  -fx-background-radius: 8;
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.07), 5, 0, 0, 2);">
                <Label text="📋 Mô tả sản phẩm"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextArea fx:id="txtDescription" prefHeight="80"
                          editable="false" wrapText="true"
                          style="-fx-font-size: 13; -fx-control-inner-background: #fafafa;
                                 -fx-border-color: transparent; -fx-background-color: transparent;"/>
            </VBox>

            <!-- ── Khu vực đặt giá ─────────────────────────────── -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20;
                  -fx-background-radius: 10;
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 3);">
                <Label text="💰 Đặt giá"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Mức giá của bạn ($):"
                           style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtBidAmount"
                               promptText="Nhập số tiền..." prefWidth="180"
                               style="-fx-font-size: 14; -fx-padding: 8; -fx-background-radius: 5;
                                      -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>
                    <Button fx:id="btnPlaceBid" text="🏷 Đặt giá ngay"
                            onAction="#handlePlaceBid"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 14;
                                   -fx-padding: 8 20 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="lblMessage" text=""
                       style="-fx-font-style: italic; -fx-font-size: 13;"
                       wrapText="true"/>
            </VBox>

            <!-- ── Biểu đồ lịch sử giá realtime ───────────────── -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15;
                  -fx-background-radius: 10;
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 3);">
                <Label text="📈 Lịch sử giá (Realtime)"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <LineChart fx:id="bidChart" prefHeight="260" animated="false"
                           style="-fx-background-color: transparent;">
                    <xAxis>
                        <CategoryAxis label="Thời gian"
                                      tickLabelRotation="45"
                                      style="-fx-font-size: 11;"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Giá ($)"
                                    style="-fx-font-size: 11;"/>
                    </yAxis>
                </LineChart>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
