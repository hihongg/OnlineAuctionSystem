<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="15"
      style="-fx-padding: 30; -fx-background-color: #000000;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.ItemDetailController"
      stylesheets="@dark-theme.css">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="⬅ Quay lại" onAction="#handleBackToDashboard"
                style="-fx-background-color: #222222; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 8 15 8 15; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="CHI TIẾT SẢN PHẨM"
               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: #000000; -fx-background-insets: 0;">

        <StackPane alignment="TOP_CENTER">
            <VBox spacing="20" maxWidth="1100" style="-fx-padding: 5; -fx-background-color: #000000;">

                <HBox spacing="30" style="-fx-background-color: #111111; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #222222; -fx-border-radius: 12; -fx-border-width: 1;">

                    <StackPane prefWidth="380" prefHeight="320"
                               style="-fx-background-color: #000000; -fx-background-radius: 8; -fx-border-color: #222222; -fx-border-radius: 8; -fx-border-width: 1;">
                        <ImageView fx:id="imgProduct" fitWidth="360" fitHeight="300" pickOnBounds="true" preserveRatio="true"/>
                    </StackPane>

                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblName" text="Tên sản phẩm"
                               style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white;" wrapText="true"/>
                        <Label fx:id="lblStatus" text="🟢 Đang diễn ra"
                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>

                        <Separator style="-fx-background-color: #222222;"/>

                        <Label fx:id="lblPrice" text="Giá hiện tại: $0.00"
                               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>
                        <Label fx:id="lblBidder" text="Người dẫn đầu: Chưa có"
                               style="-fx-font-size: 15; -fx-text-fill: #aaaaaa;"/>
                        <Label fx:id="lblTime" text="⏱ Đang tải..."
                               style="-fx-font-size: 16; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>

                        <Region VBox.vgrow="ALWAYS" minHeight="20"/>

                        <VBox spacing="10" style="-fx-background-color: #1a1a1a; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="💰 Tham gia đặt giá"
                                   style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Mức giá ($):"
                                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #aaaaaa;"/>
                                <TextField fx:id="txtBidAmount" promptText="Nhập số tiền..." prefWidth="180"
                                           style="-fx-font-size: 14; -fx-padding: 8; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #555555; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Button fx:id="btnPlaceBid" text="🏷 Đặt giá ngay" onAction="#handlePlaceBid"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 8 20 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                            </HBox>
                            <Label fx:id="lblMessage" text="" style="-fx-font-style: italic; -fx-font-size: 13;" wrapText="true"/>
                        </VBox>
                    </VBox>
                </HBox>

                <VBox spacing="10" style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #222222; -fx-border-radius: 12; -fx-border-width: 1;">
                    <Label text="📋 Mô tả sản phẩm"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>

                    <TextArea fx:id="txtDescription" prefHeight="100" minHeight="100" editable="false" wrapText="true"
                              style="-fx-font-size: 14; -fx-control-inner-background: #000000; -fx-background-color: #000000; -fx-text-fill: white; -fx-border-color: #333333; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6;"/>

                    <HBox alignment="CENTER">
                        <Button fx:id="btnToggleDescription" text="🔽 Xem thêm" onAction="#handleToggleDescription"
                                style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #222222; -fx-border-radius: 12; -fx-border-width: 1;">
                    <Label text="📈 Lịch sử giá (Realtime)"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>
                    <LineChart fx:id="bidChart" prefHeight="300" animated="false" style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis label="Thời gian" tickLabelRotation="45" style="-fx-tick-label-fill: white; -fx-font-size: 11;"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Giá ($)" style="-fx-tick-label-fill: white; -fx-font-size: 11;"/>
                        </yAxis>
                    </LineChart>
                </VBox>

            </VBox>
        </StackPane>
    </ScrollPane>
</VBox>