<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.ItemCardController"
      prefWidth="220.0" prefHeight="330.0" spacing="10"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-cursor: hand; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-border-width: 1;"
      fx:id="cardContainer">

    <StackPane prefHeight="150.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 8;">
        <ImageView fx:id="imgProduct" fitWidth="180.0" fitHeight="140.0" pickOnBounds="true" preserveRatio="true"/>
    </StackPane>

    <Label fx:id="lblName" text="Product Name" wrapText="true" maxHeight="45.0" minHeight="45.0"
           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

    <VBox spacing="2">
        <Label text="Giá hiện tại:" style="-fx-font-size: 11; -fx-text-fill: #6B7280;"/>
        <Label fx:id="lblPrice" text="\$0.00" style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: #0064D2;"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Label fx:id="lblTime" text="⏱ 00:00:00" style="-fx-font-size: 12; -fx-text-fill: #E67E22; -fx-font-weight: 500;"/>
</VBox>