<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox prefHeight="500.0" prefWidth="800.0"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.LoginController"
      style="-fx-background-image: url('/images/LoginView.jpg'); -fx-background-size: cover; -fx-background-position: center center;">

    <VBox prefWidth="400.0" alignment="CENTER" spacing="15.0"
          style="-fx-background-color: transparent; -fx-padding: 40;">

        <Label text="Create Account" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <TextField fx:id="txtUsername" promptText="Username"
                   style="-fx-pref-height: 40; -fx-background-radius: 5;"/>

        <PasswordField fx:id="txtPassword" promptText="Password"
                       style="-fx-pref-height: 40; -fx-background-radius: 5;"/>

        <PasswordField fx:id="txtConfirmPassword" promptText="Confirm Password"
                       style="-fx-pref-height: 40; -fx-background-radius: 5;"/>

        <!-- Role selection -->
        <fx:define>
            <ToggleGroup fx:id="roleGroup"/>
        </fx:define>
        <HBox alignment="CENTER" spacing="15.0">
            <Label text="Role:" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <RadioButton fx:id="radioBidder" text="Bidder" toggleGroup="$roleGroup" selected="true"
                         style="-fx-text-fill: white; -fx-font-size: 13;"/>
            <RadioButton fx:id="radioSeller" text="Seller" toggleGroup="$roleGroup"
                         style="-fx-text-fill: white; -fx-font-size: 13;"/>
        </HBox>

        <CheckBox text="I agree to the terms..." style="-fx-text-fill: white;"/>

        <Button text="Sign Up" onAction="#handleSignUp" prefWidth="320.0"
                style="-fx-background-color: #4C4DD1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;"/>

        <Button text="Already have an account? Login" onAction="#handleGoToLogin" prefWidth="320.0"
                style="-fx-background-color: #4C4DD1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </VBox>
</HBox>
