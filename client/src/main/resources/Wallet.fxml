<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox prefHeight="600.0" prefWidth="860.0" spacing="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: #000000;">
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: #111111; -fx-padding: 18 25 18 25; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
        <Label text="VÍ CỦA TÔI"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #F8C938;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblUsername"
               style="-fx-font-size: 13; -fx-text-fill: #aaaaaa;"/>
        <Button text="&lt; Quay lại" onAction="#handleBack"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 18 7 18; -fx-background-radius: 20; -fx-cursor: hand;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: #000000; -fx-background-color: transparent; -fx-background-insets: 0;">
        <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #000000;">

            <HBox spacing="20">
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #111111; -fx-background-radius: 16; -fx-padding: 30; -fx-border-color: #222222; -fx-border-radius: 16; -fx-border-width: 1;">
                    <Label text="SỐ DƯ HIỆN TẠI"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #aaaaaa;"/>
                    <Label fx:id="lblBalance" text="0.00"
                           style="-fx-font-size: 42; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                    <Label text="Số dư khả dụng để đặt giá"
                           style="-fx-font-size: 13; -fx-text-fill: #aaaaaa;"/>
                    <Button text="Cập nhật" onAction="#handleRefreshBalance"
                            style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-size: 12; -fx-cursor: hand; -fx-underline: true;"/>
                </VBox>

                <VBox spacing="10" prefWidth="260"
                      style="-fx-background-color: #111111; -fx-background-radius: 16; -fx-padding: 25; -fx-border-color: #222222; -fx-border-radius: 16; -fx-border-width: 1;">
                    <Label text="Cách hoạt động"
                           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="- Nạp tiền để có số dư đấu giá"
                           style="-fx-font-size: 13; -fx-text-fill: #aaaaaa; -fx-wrap-text: true;"/>
                    <Label text="- Khi đặt giá, số tiền bị giữ lại"
                           style="-fx-font-size: 13; -fx-text-fill: #aaaaaa; -fx-wrap-text: true;"/>
                    <Label text="- Nếu bị vượt giá, tiền được hoàn lại ngay"
                           style="-fx-font-size: 13; -fx-text-fill: #aaaaaa; -fx-wrap-text: true;"/>
                    <Label text="- Người thắng: số tiền đặt giá bị trừ vĩnh viễn"
                           style="-fx-font-size: 13; -fx-text-fill: #aaaaaa; -fx-wrap-text: true;"/>
                </VBox>
            </HBox>

            <VBox spacing="15"
                  style="-fx-background-color: #111111; -fx-background-radius: 16; -fx-padding: 30; -fx-border-color: #222222; -fx-border-radius: 16; -fx-border-width: 1;">

                <Label fx:id="lblDepositTitle" text="Gửi yêu cầu nạp tiền"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Label fx:id="lblDepositNote" text=""
                       style="-fx-font-size: 12; -fx-text-fill: #aaaaaa; -fx-font-style: italic;" wrapText="true"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Số tiền muốn nạp (USD):"
                           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtAmount"
                               promptText="Nhập số tiền (VD: 500)"
                               prefWidth="220"
                               style="-fx-font-size: 15; -fx-padding: 10 15 10 15; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #222222; -fx-border-width: 1.5; -fx-background-color: #000000; -fx-text-fill: white;"/>
                    <Button fx:id="btnDeposit" text="Gửi yêu cầu" onAction="#handleDeposit"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 24 10 24; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Nạp nhanh:" style="-fx-font-size: 13; -fx-text-fill: #aaaaaa;"/>
                    <Button text="100 USD" onAction="#handleQuickDeposit100"
                            style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 14 6 14; -fx-background-radius: 20; -fx-cursor: hand;"/>
                    <Button text="500 USD" onAction="#handleQuickDeposit500"
                            style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 14 6 14; -fx-background-radius: 20; -fx-cursor: hand;"/>
                    <Button text="1000 USD" onAction="#handleQuickDeposit1000"
                            style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 14 6 14; -fx-background-radius: 20; -fx-cursor: hand;"/>
                    <Button text="5000 USD" onAction="#handleQuickDeposit5000"
                            style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 14 6 14; -fx-background-radius: 20; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="lblMessage" text=""
                       style="-fx-font-size: 14; -fx-font-style: italic;" wrapText="true"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>